# Backend — copy to `.env` in this folder (repository root). Do not commit real secrets.

# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/uninavigator?retryWrites=true&w=majority

# Signing key for JWT access tokens — use a long random string in production.
JWT_SECRET=change-me-to-at-least-16-random-characters
JWT_EXPIRES_IN=7d

# Listening port — your host usually injects PORT in production (defaults to 3000 otherwise).
PORT=3000

# Optional: comma-separated origins, or "*" to reflect request origin (default).
CORS_ORIGIN=*

# Optional SMTP (concern forwarding emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
