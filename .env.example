# Backend — copy to `.env` in this folder (repository root). Do not commit real secrets.

# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=mongodb://WMT:WMT123@ac-yfzhooj-shard-00-00.qsf4mw7.mongodb.net:27017,ac-yfzhooj-shard-00-01.qsf4mw7.mongodb.net:27017,ac-yfzhooj-shard-00-02.qsf4mw7.mongodb.net:27017/?ssl=true&replicaSet=atlas-3u1mgj-shard-0&authSource=admin&appName=Cluster0
# Signing key for JWT access tokens — use a long random string in production.
JWT_SECRET=change-me-to-at-least-16-random-characters
JWT_EXPIRES_IN=7d

# Listening port — your host usually injects PORT in production (defaults to 5000 otherwise).
PORT=5000

# Optional: comma-separated origins, or "*" to reflect request origin (default).
CORS_ORIGIN=*

# Optional SMTP (concern forwarding emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
