# Expo loads EXPO_PUBLIC_* at build/start time.
# Set this to your hosted API origin (HTTPS URL, no trailing slash).

EXPO_PUBLIC_API_URL=https://your-api.example.com

# Android emulator: http://10.0.2.2:3000 to reach the API on your machine at localhost:3000.
# iOS Simulator: http://localhost:3000 often works.
